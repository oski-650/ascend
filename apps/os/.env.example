ASCEND_VAULT_PATH=/absolute/path/to/your/Obsidian/Ascend

# ── Operator auth perimeter (REQUIRED) ──
# Ascend OS has write and delete authority over the live business vault, so every
# operator surface sits behind middleware.ts. Both values are REQUIRED: if either is
# missing the perimeter fails CLOSED and authenticates nobody.
#
# The client portal (/portal/*) is unaffected — it authenticates with its own invite
# token and stays reachable without these.
#
# Generate strong values with:
#   node -e "console.log(require('node:crypto').randomBytes(18).toString('base64url'))"  # password
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"  # secret
#
# Rotating ASCEND_OS_SESSION_SECRET immediately invalidates every active session.
ASCEND_OS_PASSWORD=generate-a-strong-password
ASCEND_OS_SESSION_SECRET=generate-a-32-byte-random-secret

# Optional — for /maintenance Lighthouse audits.
# Anonymous PSI calls get rate-limited fast (HTTP 429). With a free Google API key,
# you get 25k queries/day. To set up:
#   1. Go to https://console.cloud.google.com/apis/credentials
#   2. Enable "PageSpeed Insights API"
#   3. Create an API key (no restrictions needed for local dev)
#   4. Paste the key here, restart the dev server
# PAGESPEED_API_KEY=your-key-here
